# Nest en el host → Postgres en localhost
DATABASE_URL=postgres://postgres:123456@localhost:5432/neondb

# API en Docker y Postgres en el host (Windows / macOS)
# DATABASE_URL=postgres://postgres:123456@host.docker.internal:5432/neondb

# Prod / Neon (ssl obligatorio) — valor real solo en .env o secretos de CI, no en git
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

PORT=3000

# Contenedor Docker: migrar al arrancar si hay pendientes (default true). false = solo Nest.
RUN_MIGRATIONS=true
